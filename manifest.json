{
  "manifest_version": 3,
  "name": "D&D Table Copilot — Live Session, Puzzle & AboveVTT Dashboard",
  "short_name": "D&D Copilot",
  "version": "1.0.0",
  "description": "Player-fair live D&D companion: listens to table talk, tracks AboveVTT rolls & combat damage, syncs D&D Beyond party sheets, solves puzzles, and suggests optimal spells.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open D&D Table Copilot Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.dndbeyond.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
